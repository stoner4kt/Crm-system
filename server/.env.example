# ─── Server ──────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# JWT secret used for local-dev auth fallback (any long random string).
# In production (Supabase mode) Supabase Auth tokens are validated instead.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ─── Supabase (optional — omit for in-memory local store) ────────────────
# Project URL + API keys from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# ─── Resend (optional — omit to log emails to the console) ───────────────
# https://resend.com/api-keys
RESEND_API_KEY=re_your-api-key
RESEND_FROM_EMAIL=TradePro CRM <onboarding@resend.dev>
RESEND_REPLY_TO=sales@yourdomain.com

# ─── Public email capture endpoint ───────────────────────────────────────
# When REQUIRE_CAPTURE_SECRET=1, clients must send this secret in an
# `x-capture-secret` header. Leave empty to keep the endpoint public.
REQUIRE_CAPTURE_SECRET=0
CAPTURE_SECRET=

# ─── CORS ────────────────────────────────────────────────────────────────
CORS_ORIGIN=*