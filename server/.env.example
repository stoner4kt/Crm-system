# ─── Server ──────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# JWT secret used for local-dev auth fallback (any long random string).
# In production (Supabase mode) Supabase Auth tokens are validated instead.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ─── Supabase (optional — omit for in-memory local store) ────────────────
# Project URL + API keys from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# ─── Resend (optional — omit to log emails to the console) ───────────────
# https://resend.com/api-keys
RESEND_API_KEY=re_your-api-key
RESEND_FROM_EMAIL=TradePro CRM <onboarding@resend.dev>
RESEND_REPLY_TO=sales@yourdomain.com

# ─── Public email capture endpoint ───────────────────────────────────────
# When REQUIRE_CAPTURE_SECRET=1, clients must send this secret in an
# `x-capture-secret` header. Leave empty to keep the endpoint public.
REQUIRE_CAPTURE_SECRET=0
CAPTURE_SECRET=

# ─── CORS ────────────────────────────────────────────────────────────────
CORS_ORIGIN=*

# ─── ReviewFlow integration (optional — omit for a pure-CRM deploy) ────
# REVIEWFLOW_URL base (e.g. https://<project-ref>.supabase.co; the edge
# functions live under /functions/v1). Set both URL + SECRET to enable the
# combined experience:  lead-won / project-completed -> ReviewFlow lead +
# review email; review-status badges in the dashboard.

# This secret must match INTEGRATION_SECRET set on the ReviewFlow edge functions。
REVIEWFLOW_URL=https://your-reviewflow-project.supabase.co
REVIEWFLOW_SECRET=shared-integration-secret
REVIEWFLOW_AUTO_SEND=true

# ─── Cloudflare Workers deployment ────────────────────────────────────────
# See wrangler.jsonc — deploy with:  npm run deploy:worker
# The Worker reads the same env vars above from wrangler / dashboard bindings.

# ReviewFlow integration secrets are set via wrangler secret put:
#   wrangler secret put SUPABASE_SERVICE_KEY
#   wrangler secret put RESEND_API_KEY
#   wrangler secret put JWT_SECRET
#   wrangler secret put REVIEWFLOW_SECRET
#   wrangler secret put CAPTURE_SECRET