{
  // TradePro CRM API - Cloudflare Workers deployment.
  // Express runs inside the Worker via the node:http compatibility layer.
  // Deploy:  npm run deploy:worker  (or  wrangler deploy --config wrangler.jsonc)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tradepro-crm-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  //
  // Runtime configuration for the Worker.
  //
  //   Non-secret variables  → declared in "vars" below. This is what makes the
  //                           "vars get wiped on deploy" problem disappear:
  //                           when a variable is in the config, wrangler sets
  //                           it on every deploy, so there is nothing to wipe.
  //   Secrets               → keep in the Cloudflare dashboard (Worker →
  //                           Settings → Variables and Secrets). Secrets are
  //                           NEVER deleted by wrangler deploys, so they are
  //                           safe there.
  //
  // IMPORTANT: do NOT set "keep_vars": true in this file. When keep_vars is
  // set, wrangler first fetches the worker's existing dashboard bindings, and
  // that metadata fetch FAILS inside the Worker Builds deploy sandbox with
  // "Unable to fetch bindings, routes, or services metadata from the
  // dashboard." The correct pattern for Worker Builds is: vars in config +
  // secrets in the dashboard.
  //
  "vars": {
    "NODE_ENV": "production",
    "CORS_ORIGIN": "https://crm-system-2b2.pages.dev"
    // Uncomment before deploying (Step 3.2 of DEPLOYMENT-GUIDE.md):
    // "SUPABASE_URL": "https://<crm-project-ref>.supabase.co",
    // "SUPABASE_ANON_KEY": "the anon (public) key of the CRM project",
  },
  "observability": {
    "enabled": true
  }
}