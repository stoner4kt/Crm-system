{
  // TradePro CRM API - Cloudflare Workers deployment.
  // Express runs inside the Worker via the node:http compatibility layer.
  // Deploy:  npm run deploy:worker  (or  wrangler deploy --config wrangler.jsonc)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tradepro-crm-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  //
  // Manage runtime configuration in the Cloudflare dashboard
  // (Worker → Settings → Variables and Secrets), NOT here:
  //
  //   Variables:  SUPABASE_URL, SUPABASE_ANON_KEY, REVIEWFLOW_URL,
  //               NODE_ENV=production, CORS_ORIGIN=<pages origin>
  //   Secrets:    SUPABASE_SERVICE_KEY, RESEND_API_KEY, JWT_SECRET,
  //               REVIEWFLOW_SECRET
  //
  // keep_vars: by default wrangler treats the config file as the source of
  // truth for vars and DELETES every dashboard variable on each deploy.
  // Setting keep_vars=true preserves dashboard-set variables so they survive
  // deploys. Secrets are never deleted by deployments regardless of this
  // flag. There is intentionally no "vars" block below — all variables are
  // managed from the dashboard (see DEPLOYMENT-GUIDE.md Part 3).
  //
  "keep_vars": true,
  "observability": {
    "enabled": true
  }
}