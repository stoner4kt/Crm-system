{
  // TradePro CRM API - Cloudflare Workers deployment.
  // Express runs inside the Worker via the node:http compatibility layer.
  // Deploy:  npm run deploy:worker  (or  wrangler deploy --config wrangler.jsonc)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tradepro-crm-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  //
  // IMPORTANT — there is intentionally NO "vars" block here. Wrangler treats
  // the deployed "vars" as fully owned by the config: on every deploy it
  // removes any dashboard variable not listed in this file. Listing even one
  // var here would delete all of the dashboard-set variables below, flipping
  // the API into local (in-memory) mode and disabling the review integration.
  //
  // All runtime configuration lives ONLY in the Cloudflare dashboard
  // (Worker → Settings → Variables and Secrets):
  //
  //   Variables:  SUPABASE_URL, SUPABASE_ANON_KEY, REVIEWFLOW_URL,
  //               NODE_ENV=production, CORS_ORIGIN=<pages origin>
  //   Secrets:    SUPABASE_SERVICE_KEY, RESEND_API_KEY, JWT_SECRET,
  //               REVIEWFLOW_SECRET
  //
  "observability": {
    "enabled": true
  }
}